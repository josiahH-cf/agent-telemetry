{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-telemetry/outcomes-record-v1",
  "title": "Successor outcome record",
  "description": "One outcome from the Obsidian Agent console rebuild's receipt feed: counts, dispositions and linkage only. No title, prompt, path, project name or native identifier is present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "producer",
    "environment",
    "outcome_kind",
    "first_at",
    "last_at",
    "events",
    "questions",
    "answers",
    "checks_passed",
    "checks_failed",
    "publication_status",
    "updates_applied",
    "updates_failed",
    "disposition",
    "linkage",
    "vendors"
  ],
  "properties": {
    "project_id": {"type": ["string", "null"], "description": "Additive stable projects.project_code join; null for shared/unattributed outcomes."},
    "project_attribution": {"type": "string", "enum": ["exact", "correlated", "shared", "unattributed"]},
    "delivered": {"type": "boolean"},
    "review_verdict": {"type": ["string", "null"], "enum": ["accepted", "needs-changes", null]},
    "acceptance_basis": {"type": ["string", "null"], "enum": ["human", "review-recorded", null]},
    "attempts": {"type": ["integer", "null"], "minimum": 0},
    "attempt_basis": {"type": "string", "enum": ["explicit_attempt_ids", "session_bindings", "complete_refinement_capture", "not_observed"]},
    "repairs": {"type": ["integer", "null"], "minimum": 0},
    "human_interventions": {"type": ["integer", "null"], "minimum": 0},
    "measurement_since": {"type": ["string", "null"]},
    "measurement_complete": {"type": "boolean"},
    "verification_observed": {"type": "boolean"},
    "receipt_code_revisions": {"type": ["integer", "null"], "minimum": 0},
    "usage_attribution": {"type": "string", "enum": ["shared-session", "exact-exclusive-session", "incomplete"]},
    "api_equivalent_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "unpriced_tokens": {"type": ["integer", "null"], "minimum": 0},
    "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
    "closed_waiting_seconds": {"type": ["number", "null"], "minimum": 0},
    "open_waits": {"type": "integer", "minimum": 0},
    "outcome_id": {
      "type": "string",
      "pattern": "outc-[0-9a-f]{16}",
      "description": "One-way public outcome identifier."
    },
    "producer": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "personal",
        "work"
      ]
    },
    "outcome_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "integer"
    },
    "questions": {
      "type": "integer"
    },
    "answers": {
      "type": "integer"
    },
    "checks_passed": {
      "type": "integer"
    },
    "checks_failed": {
      "type": "integer"
    },
    "publication_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "updates_applied": {
      "type": "integer"
    },
    "updates_failed": {
      "type": "integer"
    },
    "disposition": {
      "type": "string"
    },
    "linkage": {
      "type": "string",
      "enum": [
        "exact",
        "correlated",
        "unattributed"
      ]
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "anthropic",
          "openai",
          "cursor"
        ]
      }
    }
  }
}
