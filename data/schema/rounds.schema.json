{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-telemetry/rounds-record-v1",
  "title": "Governed-loop round record",
  "description": "One outcome-rich loop round; build and judge attribution remain distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": ["round_id", "spec_id", "row_id", "round_number", "verdict", "accepted", "started_at", "ended_at", "duration_minutes", "findings", "builder_vendor", "builder_model", "builder_tokens", "builder_cost_usd", "builder_attribution", "judge_vendor", "judge_model", "judge_tokens", "judge_cost_usd", "judge_attribution", "tokens", "api_equivalent_cost_usd", "unpriced_tokens", "cost_status"],
  "properties": {
    "round_id": {"type": "string", "description": "Stable spec-and-round join key."},
    "spec_id": {"type": ["string", "null"]},
    "row_id": {"type": ["string", "null"]},
    "round_number": {"type": "integer"},
    "verdict": {"type": ["string", "null"]},
    "accepted": {"type": "boolean"},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "duration_minutes": {"type": ["number", "null"]},
    "findings": {"type": "integer"},
    "builder_vendor": {"type": ["string", "null"]},
    "builder_model": {"type": ["string", "null"]},
    "builder_tokens": {"type": "integer"},
    "builder_cost_usd": {"type": "number"},
    "builder_attribution": {"type": ["string", "null"]},
    "judge_vendor": {"type": ["string", "null"]},
    "judge_model": {"type": ["string", "null"]},
    "judge_tokens": {"type": "integer"},
    "judge_cost_usd": {"type": "number"},
    "judge_attribution": {"type": ["string", "null"]},
    "tokens": {"type": "integer"},
    "api_equivalent_cost_usd": {"type": "number"},
    "unpriced_tokens": {"type": "integer"},
    "cost_status": {"type": ["string", "null"]}
  }
}
