{
  "schema_version": 2,
  "default_timeout_seconds": 300,
  "cache_root": "<MACHINE_LOCAL_CACHE_ROOT>",
  "claude_usage_capture": {
    "enabled": false,
    "command": "~/.local/opt/node/bin/claude",
    "timeout_seconds": 30,
    "max_cache_age_seconds": 3600
  },
  "attention": {
    "publish_attention_aggregates": false
  },
  "observatory": {
    "enabled": false,
    "roots": [
      {"root_id": "wsl_claude", "vendor": "anthropic", "host_os": "wsl", "path": "<WSL_CLAUDE_PROJECTS_DIR>"},
      {"root_id": "wsl_codex", "vendor": "openai", "host_os": "wsl", "path": "<WSL_CODEX_SESSIONS_DIR>"},
      {"root_id": "windows_claude", "vendor": "anthropic", "host_os": "windows", "path": "<WINDOWS_CLAUDE_PROJECTS_DIR>"},
      {"root_id": "windows_codex", "vendor": "openai", "host_os": "windows", "path": "<WINDOWS_CODEX_SESSIONS_DIR>"}
    ],
    "registry_paths": []
  },
  "sources": {
    "suite_state": {
      "enabled": false,
      "root": "<SUITE_STATE_DIR>"
    },
    "agent_repo": {
      "enabled": false,
      "root": "<AGENT_REPOSITORY>"
    },
    "spec_corpus": {
      "enabled": false,
      "root": "<SPEC_CORPUS_ROOT>"
    },
    "provider_usage": {
      "enabled": false,
      "root": "<PROVIDER_STATE_DIR>"
    },
    "anthropic_usage": {
      "enabled": false,
      "root": "<CLAUDE_PROJECTS_DIR>"
    },
    "openai_usage": {
      "enabled": false,
      "roots": [
        "<CODEX_WSL_SESSIONS_DIR>",
        "<CODEX_WINDOWS_SESSIONS_DIR>"
      ]
    }
  }
}
