# Machine-local configuration convention; public examples use *.example.*.
*.local.*

# Environment and secret-bearing runtime configuration.
.env
.env.*

# Runtime output, recovery copies, editor state, and local telemetry state.
*.log
*.bak
*.tmp
*.partial
*~
*.swp
*.lock
*.sqlite
*.sqlite3
*.sqlite3-*
*-cache-v*.json
scan-cache*.json
.vscode/
.idea/
.claude/

# Known local telemetry-state layouts. These are never publishable data.
.local/state/agent-telemetry/
state/agent-telemetry/
agent-telemetry-state/

# Python interpreter and test artifacts.
__pycache__/
*.pyc
.pytest_cache/
.coverage

# Crash dumps and a known Windows-interop artifact.
core
core.*
*.core
NUL
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
